# Copy to .env and fill values
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secretpassword
DB_NAME=oak_hotel_db
PORT=5000

# Identity OCR Configuration
IDENTITY_OCR_ENABLED=true
IDENTITY_OCR_PROVIDER=LOCAL_PADDLE_OCR # Options: LOCAL_PADDLE_OCR, GEMINI, MANUAL
# GEMINI_API_KEY=your_gemini_api_key_here # Required if IDENTITY_OCR_PROVIDER=GEMINI
