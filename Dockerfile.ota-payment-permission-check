FROM node:20-slim

WORKDIR /app

COPY backend/package.json backend/package-lock.json ./backend/

RUN npm --prefix backend ci --omit=dev --include=optional

COPY backend/scripts/checkOtaPaymentMigrationPermissions.js ./backend/scripts/checkOtaPaymentMigrationPermissions.js

ENV NODE_ENV=production

CMD ["node", "backend/scripts/checkOtaPaymentMigrationPermissions.js"]
