FROM node:20-slim

WORKDIR /app

COPY backend/package.json backend/package-lock.json ./backend/

RUN npm --prefix backend ci --omit=dev --include=optional

COPY backend/scripts/applyOtaPaymentResponsibilityMigration.js ./backend/scripts/

ENV NODE_ENV=production

CMD ["node", "backend/scripts/applyOtaPaymentResponsibilityMigration.js"]
